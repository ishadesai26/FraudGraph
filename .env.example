# FraudGraph Environment Configuration Example
# Copy this file to .env and adjust as needed

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Data Generation Configuration
RANDOM_SEED=42
NUM_CUSTOMERS=2000
NUM_TRANSACTIONS=10000
NUM_DEVICES=500
NUM_IPS=1000
NUM_PAYMENT_METHODS=500
NUM_MERCHANTS=100

# Directory Paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
